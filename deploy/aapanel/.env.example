# Auno Studio self-host example for aaPanel.
# Keep OPENPOST_* names for compatibility with the imported OpenPost backend.

AUNO_IMAGE_TAG=latest
AUNO_HOST_PORT=8080

OPENPOST_APP_URL=https://studio.example.com
OPENPOST_PUBLIC_URL=https://studio.example.com
OPENPOST_EDITION=selfhost
OPENPOST_DISABLE_REGISTRATIONS=false
OPENPOST_PUBLIC_PROFILES_ENABLED=true

# Generate independent production values, for example with:
# openssl rand -base64 48
OPENPOST_JWT_SECRET=replace-with-a-long-random-secret
OPENPOST_ENCRYPTION_KEY=replace-with-a-long-random-secret
OPENPOST_MEDIA_SIGNING_KEY=replace-with-a-long-random-secret

# Default: SQLite + local media.
OPENPOST_DATABASE_DRIVER=sqlite
OPENPOST_DATABASE_PATH=/data/db/auno-studio.db
OPENPOST_DATABASE_URL=
OPENPOST_STORAGE_DRIVER=local
OPENPOST_MEDIA_PATH=/data/media
OPENPOST_MEDIA_URL=/media

# Privacy-safe Auno self-host defaults.
OPENPOST_TELEMETRY_ENABLED=false
OPENPOST_UPDATE_CHECK_ENABLED=false

# Optional PostgreSQL profile.
POSTGRES_USER=auno
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_DB=auno

# Optional S3 / Cloudflare R2 / MinIO storage.
OPENPOST_S3_ENDPOINT=
OPENPOST_S3_REGION=
OPENPOST_S3_BUCKET=
OPENPOST_S3_ACCESS_KEY_ID=
OPENPOST_S3_SECRET_ACCESS_KEY=
OPENPOST_S3_PUBLIC_BASE_URL=
OPENPOST_S3_FORCE_PATH_STYLE=false

# Optional server-side AI inherited from the OpenPost provider boundary.
OPENROUTER_API_KEY=
OPENPOST_CONTENT_AI_PROVIDER=
OPENPOST_IMAGE_CAPTION_PROVIDER=
